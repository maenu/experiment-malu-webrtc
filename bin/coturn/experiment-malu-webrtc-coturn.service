[Unit]
Description=experiment-malu-webrtc coturn service
After=network.target
StartLimitIntervalSec=30
StartLimitBurst=10

[Service]
Type=simple
EnvironmentFile=/opt/experiment-malu-webrtc/.env
ExecStart=/usr/local/bin/turnserver --listening-ip="${EXPERIMENT_MALU_WEBRTC_COTURN_IP}" --relay-ip="${EXPERIMENT_MALU_WEBRTC_COTURN_IP}" --external-ip="${EXPERIMENT_MALU_WEBRTC_COTURN_IP}" \
    --cert "${EXPERIMENT_MALU_WEBRTC_CA_CERT}" --pkey "${EXPERIMENT_MALU_WEBRTC_CA_KEY}" --dtls \
    --lt-cred-mech --realm="${EXPERIMENT_MALU_WEBRTC_HOST}" --user="${EXPERIMENT_MALU_WEBRTC_COTURN_USER}:${EXPERIMENT_MALU_WEBRTC_COTURN_PASSWORD}" \
    "$EXPERIMENT_MALU_WEBRTC_COTURN_EXTRA"

[Install]
WantedBy=multi-user.target
