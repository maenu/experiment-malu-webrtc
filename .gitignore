# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

/.idea/*
!/.idea/runConfigurations

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.env

/media

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# --- aus bestehendem Projekt-Root ---
# Logs
logs
*.log
dev-debug.log
# Dependency directories
# Environment variables
# Editor directories and files
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
# OS specific

# Enthält API-Keys — nicht committen (Keys gehören in .env oder als ${ENV}-Referenz)
.mcp.json

# Laufzeit-Daten (Postgres, Backups)
/data/

# TLS-Zertifikate nicht einchecken
infra/certs/*
!infra/certs/.gitkeep

# Local agent git worktrees (never commit)
.claude/worktrees/

# POC-Demo: generierte Artefakte (per shoot*.mjs reproduzierbar) — Quelle bleibt
# versioniert, die schweren PNGs + der exportierte Foliensatz nicht.
docs/poc-demo/screenshots/
docs/poc-demo/*.html

# Relaunch-Dokumentation (Issue #85): vorher/nachher-Captures via `pnpm shoot:*`.
# Die PNGs bleiben draussen (schwer, gehören als ZIP ans Issue) — manifest.json
# dokumentiert, was wann erfasst wurde.
/screenshots/

# Playwright-MCP working dir (page snapshots, screenshots)
.playwright-mcp/

# Lighthouse CI reports (task 15) — regenerated by `pnpm lhci`
.lighthouseci/
